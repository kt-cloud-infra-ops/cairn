# security-check-cce 조직 공통 설정 예시
#
# 배치 위치: 워크스페이스의 .cairn/profile/cce.env
#   cp config/cce.env.example <워크스페이스>/.cairn/profile/cce.env
#
# CCE 기준 문서는 계속 갱신되므로 스킬은 매 실행마다 아래 페이지를 다시 읽는다.
# 조직이 다르면 이 값을 자기 환경의 기준 문서로 교체한다.

# 진단 가이드 페이지
CCE_GUIDE_URL=https://ktcloud.atlassian.net/wiki/spaces/TECHFoundation/pages/1925678414/CCE
CCE_GUIDE_PAGE_ID=1925678414

# POD CCE 항목표 페이지
CCE_ITEMS_URL=https://ktcloud.atlassian.net/wiki/spaces/SECC/pages/1925088343/-+POD+CCE
CCE_ITEMS_PAGE_ID=1925088343

# 진단 스크립트 로컬 사본 경로 (선택) — 첨부 다운로드가 막힌 환경에서 사용
#CCE_SCRIPT_DIR=/opt/cce-scripts
