# security-check-sparrow 조직 공통 설정 예시
#
# 배치 위치: 워크스페이스의 .cairn/profile/sparrow.env
#   cp config/sparrow.env.example <워크스페이스>/.cairn/profile/sparrow.env
#
# 스크립트가 현재 디렉터리에서 상위로 올라가며 .cairn/profile/sparrow.env 를 찾는다.
# 이미 export 된 환경변수가 항상 우선한다.
#
# ⚠ 자격증명(SPARROW_ID / SPARROW_PW)은 이 파일에 두지 않는다. 셸 환경변수로만 받는다.

# SourceChecker 서버 주소 (필수)
SPARROW_URL=https://<sourcechecker-host>:<port>

# 최상위/부모 프로젝트 키 (필수) — 팀 콘솔에서 확인
SPARROW_PROJECT_KEY=<parent-project-key>

# 분석 레벨 (선택, 기본 all)
#SPARROW_LEVEL=all

# 클라이언트 설치 경로 (선택, 기본 ~/sparrow_client → ~/sparrow-client)
#SPARROW_CLIENT=/opt/sparrow_client

# 사설 CA 인증서 경로 (선택) — 사내 TLS 사용 시 권장
#SPARROW_CA=/etc/ssl/certs/internal-ca.pem

# TLS 검증 비활성 (선택, 최후 수단) — SPARROW_CA 설정을 우선 검토할 것
#SPARROW_INSECURE=false

# 위험 1건 이상에서 실패 처리 (선택, CI 게이트용)
#IS_FORCE_EXIT=false
